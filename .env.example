# ── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Scraper behaviour ─────────────────────────────────────────────────────────
# Set to "false" to watch the browser (useful for debugging)
HEADLESS=true

# Max results pages to scrape per run (0 = unlimited)
MAX_PAGES=0

# Comma-separated keywords used for the quick row-level filter.
# The AI does a deeper analysis afterwards; these just reduce noise.
KEYWORDS=limpieza,seguridad,mantenimiento,servicios generales,vigilancia,fumigacion,jardineria

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=seace_leads.db
DOWNLOAD_DIR=downloads

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
